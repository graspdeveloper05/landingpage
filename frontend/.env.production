# Production build only. Vite reads this during `npm run build`, so the live
# site talks to the Laravel API while `npm run dev` keeps running against the
# local data files.
#
# The API is published on its own subdomain, because that is what deploy.sh
# does: it symlinks API_DOC_ROOT at backend/public, which keeps the Laravel
# app itself outside public_html. Serving it from a path on the primary domain
# instead would mean the SPA's catch-all rewrite and Laravel's front
# controller fighting over the same document root.
#
# Origin only -- api.ts appends /api/... itself. Nothing secret belongs in a
# VITE_ variable: they are compiled into the public bundle.
VITE_API_BASE_URL=https://api.serinegaradialogue.org
